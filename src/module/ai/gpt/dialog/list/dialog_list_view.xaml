<DialogListView Layouter="VerticalLayouter" BackgroundColor="#F8F8F8">
	<HorizontalBox FixedHeight="50" CrossAxisAlignment="Center" Margin="8,0,8,0">
		<Button 
			Name="newDialogButton" 
			FixedSize="32,32" 
			Text="+" 
			Tooltip="Start a new dialog (CTRL+N)" />
	</HorizontalBox>
	<ListControl 
		Name="listControl" 
		Border="0" 
		Margin="2,0,0,0"
		AllowHorizontalScroll="false" 
		AutoHideScrollBars="true"
		ScrollBarThickness="10"
		BackgroundColor="Transparent">
		<ListControl.VerticalScrollBar>
			<ThinScrollBar />
		</ListControl.VerticalScrollBar>
	</ListControl>
</DialogListView>