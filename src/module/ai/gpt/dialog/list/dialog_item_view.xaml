<DialogItemView Padding="6,0,4,0">
	<DialogItemView.Label>
		<Label TextColor="Black" ParagraphAlignment="Center" />
	</DialogItemView.Label>
    <DialogItemView.BackgroundColorPicker>
        <If IsSelected="true">
            <Color>#300078d7</Color>
        </If>
		<If IsMouseOver="true">
			<Color>#100078d7</Color>
		</If>
        <Color>Transparent</Color>
    </DialogItemView.BackgroundColorPicker>
</DialogItemView>